{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/dg-whp",
      "destination": "/dg-saic/index.html"
    },
    {
      "source": "/dg-whp/",
      "destination": "/dg-saic/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/confidentialite/index.html"
    },
    {
      "source": "/privacy/",
      "destination": "/confidentialite/index.html"
    },
    {
      "source": "/terms",
      "destination": "/conditions/index.html"
    },
    {
      "source": "/terms/",
      "destination": "/conditions/index.html"
    }
  ]
}
